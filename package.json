{
    "name": "firestore-durable",
    "version": "0.0.0",
    "private": true,
    "description": "Durable-execution primitives for Cloud Functions, Firestore and Cloud Tasks: fenced leases, idempotent task enqueue, event ledger, transactional outbox and per-key mailboxes. Durable by convergence, not by replay.",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "NOTICE"],
    "engines": { "node": ">=24" },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:emulator": "firebase emulators:exec --project demo-firestore-durable --only firestore 'jest --config jest.emulator.config.js --runInBand'",
        "check": "npm run typecheck && npm run build && npm test && npm run test:emulator"
    },
    "peerDependencies": { "firebase-admin": "^14.5.0" },
    "devDependencies": {
        "@swc/core": "^1.16.21",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "firebase-admin": "^14.5.0",
        "firebase-functions": "^7.3.0",
        "firebase-tools": "^15.34.2",
        "jest": "^30.4.2",
        "typescript": "^7.0.2"
    }
}
