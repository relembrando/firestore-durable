{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "jest"]
    },
    "include": ["src", "test", "examples"]
}
